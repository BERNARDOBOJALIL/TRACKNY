# ===========================================
# Trackny Detector (PC con camara + YOLO)
# ===========================================
# Este archivo va en la PC donde corre python app.py

# Publicar a tu servicio cloud en Render:
REMOTE_INGEST_URL=https://trackny.onrender.com/
INTERNAL_API_TOKEN=f93a150c3730ee7cad56c49d14a4f1da

# Modo detector-only (no expone API local):
RUN_LOCAL_API=false

# Frecuencia de push de estados:
REMOTE_STATE_INTERVAL=1.0

# Video remoto opcional:
REMOTE_VIDEO_ENABLED=true
REMOTE_VIDEO_FPS=5
REMOTE_JPEG_QUALITY=70

# Tu configuracion local de deteccion:
VIDEO_PATH=
YOLO_MODEL=yolo26n.pt
TIEMPO_PARA_OCUPAR=10
TIEMPO_PARA_DESOCUPAR=5

# Mongo opcional local (si no usas, dejalo vacio):
MONGO_URI=
MONGO_DB_NAME=trackny
MONGO_COLLECTION=occupancy_daily
MONGO_FLUSH_INTERVAL=86400
