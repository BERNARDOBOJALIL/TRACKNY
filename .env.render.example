# ==============================
# Trackny Cloud (Render)
# ==============================
# Copia estos valores en las Environment Variables del servicio en Render.

# Seguridad de endpoints internos:
INTERNAL_API_TOKEN=REEMPLAZA_CON_TOKEN_LARGO_Y_SECRETO
ALLOW_INSECURE_INTERNAL=false

# Zonas esperadas (opcional, puede crecer dinamicamente):
ZONE_NAMES=zona1,zona2,zona3,zona4,zona5,zona6

# Host/Port: en Render normalmente no hace falta tocarlo porque usa $PORT.
HOST=0.0.0.0
PORT=8000
